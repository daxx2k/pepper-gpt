<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/immersive_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="#F5F5DC"
        android:padding="24dp">

        <!-- Left side: Illustration -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:background="@drawable/bg_story_illustration_panel">

            <ImageView
                android:id="@+id/story_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="32dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_book_placeholder"
                android:contentDescription="Storybook placeholder" />

            <TextView
                android:id="@+id/story_placeholder_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="24dp"
                android:fontFamily="serif"
                android:text="Illustration loading..."
                android:textColor="#8B7355"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/story_illustration"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Story illustration" />
            
            <ProgressBar
                android:id="@+id/story_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Right side: Story Text -->
        <ScrollView
            android:id="@+id/story_scroll_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="16dp">

            <TextView
                android:id="@+id/story_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="#2E1A0E"
                android:textSize="22sp"
                android:lineSpacingExtra="4dp"
                android:text="Once upon a time..." />
        </ScrollView>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_close_immersive"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Close"
        android:tint="#2E1A0E"/>



</FrameLayout>
