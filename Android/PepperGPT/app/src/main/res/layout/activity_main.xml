<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@android:color/darker_gray"
        app:title="PepperGPT"
        app:titleTextColor="@android:color/white"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>

    <!-- Status row -->
    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="end">

        <!-- Wi-Fi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/wifiStatusIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Wi-Fi status"
                android:src="@drawable/circle_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Wi-Fi"
                android:textSize="14sp"
                android:textColor="@android:color/black"/>
        </LinearLayout>

        <!-- OpenAI -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/openaiStatusIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="OpenAI status"
                android:src="@drawable/circle_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  AI"
                android:textSize="14sp"
                android:textColor="@android:color/black"/>
        </LinearLayout>

        <!-- Clock -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/clockStatusIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Clock status"
                android:src="@drawable/circle_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Clock"
                android:textSize="14sp"
                android:textColor="@android:color/black"/>
        </LinearLayout>

        <!-- Battery -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/batteryLevelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔋 --%"
                android:textSize="14sp"
                android:textColor="@android:color/black"/>
        </LinearLayout>


    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Chat History (RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/conversation_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <!-- 📸 Camera viewfinder / Photo preview overlay -->
        <ImageView
            android:id="@+id/viewfinder_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Camera feedback" />

        <!-- Status Text Overlay -->
        <TextView
            android:id="@+id/statusOverlayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Processing..."
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#80000000"
            android:padding="16dp"
            android:visibility="gone"
            android:elevation="10dp"/>
    </FrameLayout>

    <!-- ⏳ Spinner + thinking text -->
    <LinearLayout
        android:id="@+id/spinnerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:padding="8dp">

        <ProgressBar
            android:id="@+id/loadingSpinner"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@android:color/darker_gray"
            style="@android:style/Widget.DeviceDefault.Light.ProgressBar" />

        <TextView
            android:id="@+id/thinkingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thinking..."
            android:textSize="16sp"
            android:textStyle="italic"
            android:paddingStart="8dp"
            android:textColor="@android:color/darker_gray" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_rounded_button"
            android:backgroundTint="#FF4444"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Cancel"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/listenToggleButton"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_rounded_button"
        android:backgroundTint="#808080"
        android:text="Start Listening"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="8dp"/>

</LinearLayout>
